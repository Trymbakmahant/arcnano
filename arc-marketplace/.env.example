# ==============================================================================
# Arcnano Marketplace - Environment Variables
# Copy this file to .env.local and add your Supabase credentials
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Public Key (safe for client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (optional, for backend operations bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=
