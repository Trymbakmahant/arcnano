# Arc Testnet Deployment Configuration
ARC_RPC_URL="https://rpc.testnet.arc.network"

# Your funded deployer wallet private key (get testnet USDC at https://faucet.circle.com)
PRIVATE_KEY="<YOUR_PRIVATE_KEY_HERE>"

# Official Arc Testnet USDC System Contract (Chain ID: 5042002)
USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# Optional: Groth16 Verifier Contract Address (If omitted, a testnet verifier is deployed automatically)
# VERIFIER_ADDRESS="0x..."

# Fixed Note Denomination: 10,000 raw units = 0.01 USDC (6 decimals)
DENOMINATION="10000"

# Agent Keypairs for Live Nanopayment Demo
AGENT_A_PRIVATE_KEY="<AGENT_A_PRIVATE_KEY_HERE>"
AGENT_B_PRIVATE_KEY="<AGENT_B_PRIVATE_KEY_HERE>"
